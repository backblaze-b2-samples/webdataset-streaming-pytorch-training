  "info": {
    "description": "Local API for WebDataset Streaming PyTorch Training: packs media into WebDataset .tar shards, writes them and a JSON manifest to Backblaze B2, and streams them back into a PyTorch training loop with no local staging disk. This contract documents the template's local API, not a hosted public endpoint.",
    "title": "WebDataset Streaming PyTorch Training API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/datasets": {
      "get": {
        "operationId": "list_datasets_endpoint_datasets_get",
        "responses": {
