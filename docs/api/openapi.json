            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Dataset"
                  },
                  "title": "Response List Datasets Endpoint Datasets Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Datasets Endpoint",
        "tags": [
          "datasets"
        ]
      },
      "post": {
